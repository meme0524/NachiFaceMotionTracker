#.gitignore 
# Pythonによって自動生成されるキャッシュ
__pycache__/
*.py[cod]
*.pyo

# 仮想環境（作った場合）
venv/
env/

# VSCodeの個人設定（他人に不要）
.vscode/

# ログファイル
*.log

# OSに関係する不要ファイル
.DS_Store
Thumbs.db
desktop.ini

# システムによって生成される一時ファイル
*.swp
*.tmp

# シークレットファイル（もし今後使うなら）
.env

# Unity関連の一時ファイルを除外
face_motion_receiver/Library/
face_motion_receiver/Temp/
face_motion_receiver/Obj/
face_motion_receiver/Build/
face_motion_receiver/Logs/
face_motion_receiver/UserSettings/

# Visual Studio関連
*.csproj
*.sln
*.user
.vscode/


# Unityプロジェクト全体を除外
face_motion_receiver/**
# Unityの .meta ファイル除外（Scripts内は除く）
face_motion_receiver/**/*.meta
!face_motion_receiver/Assets/Scripts/**/*.meta

# ただし Scripts フォルダだけは追跡対象にする
!face_motion_receiver/Assets/
!face_motion_receiver/Assets/Scripts/
!face_motion_receiver/Assets/Scripts/**/*.cs



